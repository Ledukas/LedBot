[Unit]
Description=LedBot Discord bot
# time-sync.target: the Pi has no clock battery, so until NTP syncs the clock
# can be hours out. Invites are timed in wall-clock seconds and the weekly job
# keys on the local date, so the bot must not start on a wrong clock. Ordering
# only (not Wants=, per systemd.special(7)); it has no effect unless
# systemd-time-wait-sync is enabled -- see DEPLOY.md.
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
# Without this, stdout is block-buffered when it isn't a terminal: print()
# lines reach the journal late, and are lost if the bot is killed.
Environment=PYTHONUNBUFFERED=1
# EDIT these two before installing: the account the bot should run as,
# and the absolute path where you cloned this repo on the Pi.
User=pi
WorkingDirectory=/home/pi/LedBot
ExecStart=/home/pi/LedBot/venv/bin/python3 /home/pi/LedBot/LedBotCode.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
